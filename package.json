{
  "name": "example-app",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "wt": "node scripts/wt/wt.mjs",
    "seed": "node scripts/seed.mjs",
    "sb": "node scripts/sb.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . && node scripts/check-one-off-styles.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project shared --project harness --project guides && pnpm -r --filter @app/ui --filter @app/mobile test",
    "test:integration": "node scripts/with-env.mjs vitest run --project integration",
    "test:db": "supabase test db --local",
    "e2e": "node scripts/maestro.mjs",
    "demo": "node scripts/demo.mjs",
    "guide": "node scripts/guide.mjs",
    "reference": "node scripts/reference.mjs",
    "link": "node scripts/link.mjs",
    "agent": "node scripts/link.mjs --agent",
    "harness:apply": "node scripts/harness/apply.mjs",
    "harness:diff": "node scripts/harness/diff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "agent-device": "0.21.31",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
