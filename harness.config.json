      "surface": "#f3f4f6",
      "surface-elevated": "#ffffff",
      "foreground": "#111827",
      "muted-foreground": "#6b7280",
      "hairline": "#e5e7eb",
      "control": "#8b919c",
      "primary": "#4f46e5",
      "primary-foreground": "#ffffff",
      "accent": "#0ea5e9",
      "accent-foreground": "#ffffff",
      "danger": "#b42318",
      "danger-soft": "#fdecea"
