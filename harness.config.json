{
  "app": {
    "name": "Acme",
    "slug": "acme",
    "scheme": "acme",
    "bundleId": "com.example.acme",
    "androidPackage": "com.example.acme",
    "platforms": ["ios", "android"]
  },
  "expo": { "sdk": "58" },
  "github": { "repo": "piopi/mobile-app-harness" },
  "harness": { "template": "piopi/mobile-app-harness", "workspaceScope": "@app" },
  "backend": "supabase",
  "reference": null,
  "brand": {
