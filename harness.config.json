    "dark": {
      "background": "#0b0d12",
      "surface": "#161a22",
      "surface-elevated": "#1e232d",
      "foreground": "#f3f4f6",
      "muted-foreground": "#9ca3af",
      "hairline": "#262b36",
      "control": "#8b919c",
      "primary": "#818cf8",
      "primary-foreground": "#0b0d12",
      "accent": "#38bdf8",
      "accent-foreground": "#0b0d12",
